{
  "name": "prisma-generator-effect",
  "version": "2.0.0",
  "description": "Prisma generator for Effect",
  "main": "dist/index.js",
  "bin": {
    "prisma-generator-effect": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run && tsx scripts/runTests.ts",
    "test:unit": "vitest run",
    "prepublishOnly": "pnpm run build",
    "changeset": "changeset",
    "changeset-version": "changeset version",
    "changeset-publish": "pnpm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dichioniccolo/prisma-effect-generator.git"
  },
  "keywords": [
    "prisma",
    "generator",
    "effect"
  ],
  "author": "Niccolo' Di Chio",
  "license": "MIT",
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@prisma/generator-helper": "^7.9.1",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@effect/vitest": "4.0.0",
    "@prisma/client": "^7.9.1",
    "@types/node": "^26.1.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}